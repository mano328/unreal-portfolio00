# 📦 Visual Studio & Build 관련
.vs/
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# 🛠️ 엔진 생성 프로젝트 파일
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# 🎨 소스 아트 무시
SourceArt/**/*.png
SourceArt/**/*.tga

# 🧱 바이너리와 빌드
Binaries/
Plugins/**/Binaries/
Build/
!Build/**/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# ⚙️ 자동 생성/캐시/중간 파일
Saved/
Intermediate/
DerivedDataCache/
Plugins/**/Intermediate/

# ❌ 기타 무시
*.tmp
MyCustomFolder/

# 🌍 언리얼 자동 생성 폴더 무시
Content/_GENERATED/
Content/Maps/_GENERATED/
Content/__ExternalObjects__/

# 🎮 외부 대용량 에셋 무시
Content/Effects/
Content/InfinityBladeAdversaries/
Content/Environments/
Content/Materials/Fog/
Content/Materials/FogCards/
Content/Maps/Topview/

# ✅ LDProps/StaticMeshes는 모두 추적
!Content/LDProps/
!Content/LDProps/StaticMeshes/
!Content/LDProps/StaticMeshes/**/*.uasset

# ❌ 더 이상 제외 없음 (이전 제외 라인은 삭제하거나 주석 처리)
# Content/LDProps/StaticMeshes/DummyProps/SM_Dummy_Cliff_01.uasset

# ✅ 레벨 파일(.umap) 추적 허용
!Content/Maps/
!Content/Maps/**/*.umap

Content/Maps/Test_GitMap.umap
Content/Maps/Test_GitMap_HLODLayer_Instanced.uasset
Content/Maps/Test_GitMap_HLODLayer_Merged.uasset

# ✅ 외부 액터 추적 허용 (Landscape 등 변경 감지)
!Content/Maps/__ExternalActors/
!Content/Maps/__ExternalActors/**/*.uasset

# ✅ Landscape Layer Info 추적 예외 추가
!Content/**/LandscapeLayerInfo/
!Content/**/LandscapeLayerInfo/**/*.uasset
!Content/**/LayerInfo/
!Content/**/LayerInfo/**/*.uasset

# 🔥 Environments 폴더 추적 허용
!Content/Environments/
!Content/Environments/**/
